# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
frontend/dist/
coverage/

# Data — raw and processed datasets are not committed (provenance is tracked in SQLite + docs)
data/raw/*
data/processed/*
data/downloads/
data/reference/
/exports/
!data/raw/.gitkeep
!data/processed/.gitkeep
*.sqlite
*.sqlite3
*.db

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
