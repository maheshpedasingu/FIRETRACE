# FIRETRACE backend configuration — copy to backend/.env and fill in locally.
# NEVER commit the real .env file. These values are read by the backend only
# and are never sent to the frontend.

# NASA FIRMS MAP_KEY (request at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# FIRMS API base URL
FIRMS_API_BASE=https://firms.modaps.eosdis.nasa.gov/api

# HTTP behaviour for FIRMS requests
FIRMS_TIMEOUT_SECONDS=30
FIRMS_MAX_RETRIES=3
# Max days per Area API request. Live FIRMS service (2026-11-14): "Expects [1..5]".
FIRMS_AREA_MAX_DAY_RANGE=5
# Transaction budget per MAP_KEY (reported limit: 5000 per 10 minutes)
FIRMS_TRANSACTIONS_PER_WINDOW=5000
FIRMS_TRANSACTION_WINDOW_SECONDS=600

# Storage: SQLite for metadata; partitioned Parquet for observations
DATABASE_URL=sqlite:///../data/firetrace.sqlite
RAW_DATA_DIR=../data/raw
PROCESSED_DATA_DIR=../data/processed
REFERENCE_DATA_DIR=../data/reference
INGEST_CHUNK_ROWS=200000
PARTITION_TILE_DEGREES=10

# Harmonization grid (equal-area, EPSG:6933), resolution in metres
GRID_CRS=EPSG:6933
GRID_RESOLUTION_M=1000

# CORS origin of the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173
